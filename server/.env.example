# 数据库配置
DATABASE_URL=postgresql://username:password@localhost:5432/predee_coupons
PGHOST=localhost
PGPORT=5432
PGUSER=your_username
PGPASSWORD=your_password
PGDATABASE=predee_coupons

# 服务器配置
PORT=3000
NODE_ENV=development

# JWT配置
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=7d

# LINE API配置
LINE_CHANNEL_ID=your_line_channel_id
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_line_access_token
LINE_LOGIN_CALLBACK_URL=http://localhost:5000/auth/line/callback

# Google Maps API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Replit存储配置
STORAGE_BUCKET_URL=https://storage.replit.com/your-bucket-name

# CORS配置
CORS_ORIGIN=http://localhost:5000
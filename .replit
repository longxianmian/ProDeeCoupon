modules = ["nodejs-20", "postgresql-17", "python-3.11"]
[agent]
expertMode = true
integrations = ["javascript_object_storage:1.0.0", "javascript_openai_ai_integrations:1.0.0"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "PreDee Server"

[[workflows.workflow]]
name = "PreDee Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd server && PORT=5000 NODE_ENV=development DEV_SKIP_AUTH=1 PRIVATE_OBJECT_DIR=/prodee-storage/uploads PUBLIC_OBJECT_SEARCH_PATHS=/prodee-storage/public node index.js"
waitForPort = 5000

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 34169
externalPort = 5173

[[ports]]
localPort = 35513
externalPort = 5000

[[ports]]
localPort = 39509
externalPort = 3003

[[ports]]
localPort = 39635
externalPort = 3002

[[ports]]
localPort = 42795
externalPort = 3001

[[ports]]
localPort = 44629
externalPort = 4200

[nix]
channel = "stable-25_05"
packages = ["try", "imagemagick_light"]

[deployment]
build = ["npm", "run", "build"]
deploymentTarget = "autoscale"
run = ["node", "server/index.js"]

[objectStorage]
defaultBucketID = "replit-objstore-98d3c1d2-c168-4c22-b046-d833ec697e5b"

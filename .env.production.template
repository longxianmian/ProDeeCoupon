# PreDee H5 System - Production Environment Variables Template
# Copy this file to .env.production and fill in actual values

# === 基础服务配置 ===
NODE_ENV=production
PORT=3000

# === 数据库配置 ===
DATABASE_URL=postgresql://username:password@host:port/database_name

# === LINE 集成配置 ===
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
LINE_CHANNEL_SECRET=your_line_channel_secret
LIFF_ID=your_liff_id

# === JWT 认证配置 ===
JWT_SECRET=your_super_secure_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# === 管理员配置 ===
ADMIN_EMAIL=admin@predee.com
ADMIN_PASSWORD=your_secure_admin_password

# === Google Services 配置 ===
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# === 对象存储配置 (Replit Storage) ===
# These are typically auto-configured in Replit environment
# REPLIT_DOMAINS=auto-configured
# REPLIT_SLUG=auto-configured
# REPLIT_STORAGE_ENDPOINT=auto-configured

# === 安全配置 ===
CORS_ORIGIN=https://your-production-domain.replit.app
ENABLE_DEV_ENDPOINTS=false
ENABLE_DEBUG_ERRORS=false

# === 监控配置 (可选) ===
# SENTRY_DSN=your_sentry_dsn_url
# LOG_LEVEL=error

# === 缓存配置 (可选) ===
# REDIS_URL=redis://your-redis-instance

# === 邮件服务配置 (可选) ===
# SMTP_HOST=your-smtp-host
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password

# === 其他第三方服务 ===
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# STRIPE_SECRET_KEY=your_stripe_secret_key
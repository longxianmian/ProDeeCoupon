import { defineConfig } from 'vite'
import vue from '@vitejs/plugin-vue'
import { fileURLToPath, URL } from 'node:url'

export default defineConfig({
  plugins: [vue()],
  resolve: {
    alias: {
      '@': fileURLToPath(new URL('./src', import.meta.url)),
      '@assets': fileURLToPath(new URL('./src/assets', import.meta.url))
    }
  },
  server: {
    host: '0.0.0.0',
    port: 5000,
    strictPort: true,
    allowedHosts: true,
    proxy: {
      // 代理API请求到后端服务器
      '/api': {
        target: 'http://localhost:3000',
        changeOrigin: true,
        secure: false,
        timeout: 60000,
        // 增加错误处理
        onError(err, req, res) {
          console.error('代理错误:', err.message)
          res.writeHead(500, {
            'Content-Type': 'text/plain'
          })
          res.end('代理服务器连接失败，请稍后重试')
        }
      },
      // 代理上传文件到后端服务器  
      '/uploads': {
        target: 'http://localhost:3000',
        changeOrigin: true,
        secure: false,
        timeout: 60000,
        onError(err, req, res) {
          console.error('文件代理错误:', err.message)
          res.writeHead(404, {
            'Content-Type': 'text/plain'
          })
          res.end('文件不存在或服务器暂时不可用')
        }
      }
    }
  },
  build: {
    outDir: 'dist',
    sourcemap: false,
    minify: 'esbuild', // 使用esbuild以获得更快的构建速度
    target: 'esnext',
    // 注: 开发环境console.log用于调试，生产环境可通过浏览器控制台过滤
    // 如需完全移除console，可使用vite-plugin-remove-console插件
    rollupOptions: {
      output: {
        // 添加时间戳到文件名，强制浏览器重新加载
        entryFileNames: `assets/[name]-[hash]-${Date.now()}.js`,
        chunkFileNames: `assets/[name]-[hash]-${Date.now()}.js`,
        assetFileNames: `assets/[name]-[hash]-${Date.now()}.[ext]`,
        manualChunks: {
          vendor: ['vue', 'vue-router', 'pinia'],
          ui: ['vant', 'element-plus'],
          utils: ['axios', 'vue-i18n']
        }
      }
    },
    chunkSizeWarningLimit: 1000
  },
  optimizeDeps: {
    include: ['vue', 'vue-router', 'pinia', 'vant', 'element-plus', 'axios', 'vue-i18n']
  }
})
# ProDee 部署忽略文件 - 减少上传大小

# 开发文件
*.md
*.log
.git
.gitignore

# 前端源代码（使用构建后的dist）
client/src
client/public
client/node_modules
client/package-lock.json

# 测试和文档
*.test.js
*.spec.js
tests/
docs/

# 临时文件
.DS_Store
*.tmp
*.swp
.env.local
.env.development

# 不需要的配置
.replit.backup
tsconfig.json
vite.config.ts
drizzle.config.ts
